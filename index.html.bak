  <section class="contact-section" id="contact">
    <div class="container-fluid px-lg-5 px-3">
      <div class="row align-items-center g-5">
        <div class="col-lg-6" data-animate>
          <div class="contact-info">
            <span class="section-tag">GET IN TOUCH</span>
            <h2>Ready to build your<br><span class="gradient-text">intelligent systems?</span></h2>
            <p class="contact-desc">Book a free 30-minute discovery call. We'll explore your use case, discuss
              feasibility, and outline a path to production.</p>

            <div class="contact-details">
              <div class="contact-item">
                <div class="contact-item-icon">
                  <i class="bi bi-envelope"></i>
                </div>
                <div class="contact-item-content">
                  <span class="contact-item-label">Email Address</span>
                  <a href="mailto:hello@novabyte.ai" class="contact-item-val">hello@novabyte.ai</a>
                </div>
              </div>

              <div class="contact-item">
                <div class="contact-item-icon">
                  <i class="bi bi-geo-alt"></i>
                </div>
                <div class="contact-item-content">
                  <span class="contact-item-label">Studio Location</span>
                  <span class="contact-item-val">San Francisco, CA</span>
                </div>
              </div>

              <div class="contact-item">
                <div class="contact-item-icon">
                  <i class="bi bi-clock-history"></i>
                </div>
                <div class="contact-item-content">
                  <span class="contact-item-label">Response Time</span>
                  <span class="contact-item-val">Within 24 hours</span>
                </div>
              </div>
            </div>


          </div>
        </div>

        <div class="col-lg-6" data-animate>
          <div class="contact-form-wrap">
            <form id="contactForm" class="contact-form">
              <div class="d-flex gap-2">
                <div class="form-group w-100">
                  <label for="name">Full Name</label>
                  <input type="text" id="name" name="name" placeholder="enter your name" required>
                </div>
                <div class="form-group w-100">
                  <label for="email">Work Email</label>
                  <input type="email" id="email" name="email" placeholder="enter your email" required>
                </div>
              </div>
              <div class="d-flex gap-2">
                <div class="form-group w-100">
                  <label for="company">Company</label>
                  <input type="text" id="company" name="company" placeholder="Your company name">
                </div>
                <div class="form-group w-100">
                  <label for="service">What do you need?</label>
                  <select id="service" name="service">
                    <option value="">Select a service</option>
                    <option value="ai-agents">AI Agents</option>
                    <option value="rag">RAG Platform</option>
                    <option value="automation">Automation Pipeline</option>
                    <option value="chatbot">Conversational AI</option>
                    <option value="analytics">AI Analytics</option>
                    <option value="consulting">AI Consulting</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label for="message">Tell us about your project</label>
                <textarea id="message" name="message" rows="4"
                  placeholder="Describe your use case, timeline, and any specific requirements..."></textarea>
              </div>
              <button type="submit" class="btn-submit" id="submitBtn">
                <span>Send Message</span>
                <i class="bi bi-send"></i>
              </button>
              <div class="form-success" id="formSuccess">
                <i class="bi bi-check-circle"></i>
                <span>Thank you! We'll get back to you within 24 hours.</span>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

