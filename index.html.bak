  <!-- SECTION 1: HERO -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="hero" id="hero">
    <div class="container-fluid px-lg-5 px-3">
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
          <div class="hero-content" data-animate>
            <div class="hero-badge">
              <span class="badge-dot"></span>
              <span>Next-Gen Enterprise AI Architecture</span>
            </div>
            <h1>
              Production-grade AI systems,
              <span class="gradient-text">engineered for enterprise scale.</span>
            </h1>
            <p class="hero-desc">
              We architect, train, and deploy observable AI agents, sub-second RAG engines, and self-healing automation
              workflows — built specifically for your proprietary data.
            </p>

            <div class="hero-actions">
              <a href="#contact" class="btn-primary">
                <span>Schedule Architecture Review</span>
                <i class="bi bi-arrow-right"></i>
              </a>
              <a href="#portfolio" class="btn-outline">
                <span>Explore Deployments</span>
                <span class="btn-arr">→</span>
              </a>
            </div>


          </div>
        </div>

        <div class="col-lg-6">
          <div class="hero-visual" data-animate>
            <!-- Engineering Terminal / Agent Workspace -->
            <div class="terminal-window">
              <div class="term-header">
                <div class="term-dots">
                  <span class="t-dot red"></span>
                  <span class="t-dot yellow"></span>
                  <span class="t-dot green"></span>
                </div>
                <div class="term-tabs">
                  <span class="term-tab active"><i class="bi bi-terminal"></i> agent_engine.ts</span>
                  <span class="term-tab"><i class="bi bi-activity"></i> telemetry.log</span>
                </div>
                <div class="term-status">
                  <span class="status-pulse"></span>
                  <span>SYSTEM_HEALTHY</span>
                </div>
              </div>

              <div class="term-body">
                <div class="term-line prefix">
                  <span class="term-prompt">agent@novabyte:~$</span>
                  <span class="term-cmd">orchestrate --workflow=rag_retrieval --model=claude-3.5</span>
                </div>

                <div class="term-card-step">
                  <div class="step-meta">
                    <span class="step-badge success">STEP 01</span>
                    <span class="step-title">Vector Ingestion & Hybrid Rerank</span>
                    <span class="step-time">38ms</span>
                  </div>
                  <div class="step-details">
                    <code>pgvector.query(embedding, top_k=24, min_similarity=0.88)</code>
                    <div class="step-stat-pills">
                      <span>Docs: 240k</span>
                      <span>Score: 0.942</span>
                      <span>Cache: HIT</span>
                    </div>
                  </div>
                </div>

                <div class="term-card-step">
                  <div class="step-meta">
                    <span class="step-badge active">STEP 02</span>
                    <span class="step-title">Tool Execution & Reasoning Chain</span>
                    <span class="step-time">81ms</span>
                  </div>
                  <div class="step-details">
                    <div class="tool-run">
                      <i class="bi bi-gear"></i>
                      <span>calling: <strong>db_lookup_policies(org_id="ENT_942")</strong></span>
                    </div>
                    <div class="tool-response">
                      <span class="chk-icon">✓</span>
                      <span>Confidence score 98.6% · Hallucination guardrails passed</span>
                    </div>
                  </div>
                </div>

                <div class="term-output-stream">
                  <div class="stream-header">
                    <span>Synthesized Output Response</span>
                    <span class="token-rate">124 tok/sec</span>
                  </div>
                  <div class="stream-content">
                    "Audit report generated: System routed request via LangGraph stateful agent. Policy validation
                    confirmed across 4 distributed nodes with zero exceptions."
                    <span class="terminal-cursor"></span>
                  </div>
                </div>
              </div>

              <div class="term-footer">
                <div class="tf-item">
                  <span class="tf-label">LATENCY:</span>
                  <span class="tf-val cyan">119ms</span>
                </div>
                <div class="tf-sep"></div>
                <div class="tf-item">
                  <span class="tf-label">EST. COST:</span>
                  <span class="tf-val">$0.0028</span>
                </div>
                <div class="tf-sep"></div>
                <div class="tf-item">
                  <span class="tf-label">ACCURACY:</span>
                  <span class="tf-val green">99.4%</span>
                </div>
                <div class="tf-right">
                  <span>trace_id: #nv-84910</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

