  <!-- ═══════════════════════════════════════════ -->
  <!-- SECTION 3: PROCESS -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="process-section" id="process">
    <div class="container-fluid px-lg-5 px-3">
      <div class="section-header" data-animate>
        <span class="section-tag">ENGINEERING METHODOLOGY</span>
        <h2>How we build & ship<br><span class="gradient-text">production systems in 4 weeks</span></h2>
        <p class="section-desc">A structured, low-risk engineering framework designed to take you from exploratory data
          audit to observable production release.</p>
      </div>

      <div class="process-track">
        <div class="row g-4">
          <div class="col-lg-3 col-md-6" data-animate>
            <div class="process-card">
              <div class="process-header">
                <span class="phase-badge">PHASE 01</span>
                <span class="phase-duration">WEEK 1</span>
              </div>
              <h3 class="process-title">Feasibility & Architecture</h3>
              <p class="process-text">
                Deep-dive audit into your raw datasets, permission models, and operational bottlenecks. We scope the
                optimal model tier, embeddings strategy, and security boundaries.
              </p>
              <div class="process-deliverables">
                <div class="deliv-item"><i class="bi bi-check2"></i> Technical Architecture Spec</div>
                <div class="deliv-item"><i class="bi bi-check2"></i> Eval Benchmark Metrics</div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-6" data-animate>
            <div class="process-card">
              <div class="process-header">
                <span class="phase-badge">PHASE 02</span>
                <span class="phase-duration">WEEK 2</span>
              </div>
              <h3 class="process-title">Data Pipeline & Retrieval</h3>
              <p class="process-text">
                Implement chunking, vector indexing, and hybrid semantic reranking. We wire up real-time sync with
                internal stores like PostgreSQL, Notion, or custom data lakes.
              </p>
              <div class="process-deliverables">
                <div class="deliv-item"><i class="bi bi-check2"></i> High-density Vector Index</div>
                <div class="deliv-item"><i class="bi bi-check2"></i> Real-time Ingestion Stream</div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-6" data-animate>
            <div class="process-card">
              <div class="process-header">
                <span class="phase-badge">PHASE 03</span>
                <span class="phase-duration">WEEK 3</span>
              </div>
              <h3 class="process-title">Agent Logic & Guardrails</h3>
              <p class="process-text">
                Construct autonomous multi-step reasoning chains using LangGraph. We implement deterministic
                hallucination guardrails, fallback handlers, and tool integrations.
              </p>
              <div class="process-deliverables">
                <div class="deliv-item"><i class="bi bi-check2"></i> Stateful LangGraph Workflows</div>
                <div class="deliv-item"><i class="bi bi-check2"></i> Automated Eval Test Suites</div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-6" data-animate>
            <div class="process-card">
              <div class="process-header">
                <span class="phase-badge">PHASE 04</span>
                <span class="phase-duration">WEEK 4</span>
              </div>
              <h3 class="process-title">Production Handoff & SLA</h3>
              <p class="process-text">
                Deploy containerized services with Datadog/LangSmith observability, autoscaling policies, CI/CD
                pipelines, and full team training with source code transfer.
              </p>
              <div class="process-deliverables">
                <div class="deliv-item"><i class="bi bi-check2"></i> Full Codebase Ownership</div>
                <div class="deliv-item"><i class="bi bi-check2"></i> 30-day Post-Launch Support</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

